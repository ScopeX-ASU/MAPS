  "cards": [
    {
      "dot": "cyan",
      "title": "Inverse-Design Loop (MAPS-InvDes)",
      "items": [
        "InvDesign drives sharpness/LR schedules and minimizes -results['obj']",
        "BaseOptimization materializes permittivity via N_Ports, level-sets, and CUDA gpu_subpixel",
        "RobustForward optionally aggregates sequential fabrication/source variation scenarios"
      ]
    },
    {
      "dot": "emerald",
      "title": "Multi-Physics & SI Normalization",
      "items": [
        "SimulatedFoM & ObjectiveFunc bridge PyTorch autograd to 2D FDFD, 3D FDTD-X, and JAX-FEM heat",
        "Chebyshev broadband modes, sparse phasors, and SI surface-area quadrature normalize power",
        "Stratton-Chu / angular-spectrum projection and ErosionDilationPenalty evaluate far-field & DRC"
      ]
    },
    {
      "dot": "violet",
      "title": "AI Surrogate Pipeline (Data & Train)",
      "items": [
        "MAPS-Data launches multi-GPU FDFD/FDTD device sweeps into structured HDF5 datasets",
        "MAPS-Train fits FNO / NeurOLight operators with data + Maxwell PDE residual losses",
        "Trained surrogates plug into ObjectiveFunc as fast forward/adjoint neural solvers"
      ]
    }
  ]
